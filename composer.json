{
  "name": "garaged/kiln-cleanup",
  "description": "Safety-first, self-hosted WordPress cleanup tooling.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "KilnCleanup\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KilnCleanup\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true
  }
}
